#!/bin/bash
# Skripti eesmärk: arvutada taiste busside arv ja ulejaanud reisijad.

echo "Sisesta reisijate arv:"
read reisijad

echo "Sisesta kohtade arv uhes bussis:"
read kohad

if [ "$reisijad" -lt 0 ] || [ "$kohad" -le 0 ]; then
    echo "Viga: reisijate arv ei tohi olla negatiivne ja kohtade arv peab olema positiivne."
    exit 1
fi

bussid=$(expr "$reisijad" / "$kohad")
ulejaanud=$(expr "$reisijad" % "$kohad")

echo "Taielikult tais busse: $bussid"
echo "Mahajaanud reisijaid: $ulejaanud"
